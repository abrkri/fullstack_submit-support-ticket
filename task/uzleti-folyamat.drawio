<mxfile host="app.diagrams.net"><diagram id="reports01" name="01 – Hibabejelentés és lezárás"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1020"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="admin" value="ADMIN" style="swimlane;horizontal=1;startSize=30;fillColor=#eaf1fb;strokeColor=#94a3b8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1520" height="240" as="geometry" /></mxCell><mxCell id="user" value="FELHASZNÁLÓ" style="swimlane;horizontal=1;startSize=30;fillColor=#eaf7f1;strokeColor=#94a3b8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1520" height="250" as="geometry" /></mxCell><mxCell id="backend" value="BACKEND" style="swimlane;horizontal=1;startSize=30;fillColor=#fff5e8;strokeColor=#94a3b8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1520" height="370" as="geometry" /></mxCell><mxCell id="send" value="Hibaleírás megadása&#10;Beküldés gomb" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#172b4d;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="390" width="220" height="85" as="geometry" /></mxCell><mxCell id="created" value="Sikerüzenet + Id&#10;A leírás kiürül" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#172b4d;fontSize=14;" vertex="1" parent="1"><mxGeometry x="400" y="390" width="220" height="85" as="geometry" /></mxCell><mxCell id="error" value="Hibaüzenet (piros)&#10;A leírás megmarad" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#172b4d;fontSize=14;" vertex="1" parent="1"><mxGeometry x="400" y="505" width="220" height="65" as="geometry" /></mxCell><mxCell id="load" value="Lista frissítése&#10;Az admin indítja" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#172b4d;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="200" height="75" as="geometry"