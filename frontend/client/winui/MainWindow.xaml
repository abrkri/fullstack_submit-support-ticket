<Window x:Class="MyApp.Client.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Hibabejelentés">
    <ScrollViewer><StackPanel x:Name="Root" Padding="24" Spacing="16">
        <TextBlock Text="Hiba bejelentése" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock Text="Írd le röviden a tapasztalt hibát!"/>
        <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" Height="140" AcceptsReturn="True" TextWrapping="Wrap"/>
        <Button Content="Hiba beküldése" Command="{Binding SubmitReportCommand}"/>
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{Binding HasError, Converter={StaticResource ErrorBrush}}"/>
    </StackPanel></ScrollViewer>
</Window>