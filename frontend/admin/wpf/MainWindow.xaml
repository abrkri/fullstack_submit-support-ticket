<Window x:Class="MyApp.Admin.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hibabejelentések adminisztrációja" Height="560" Width="900" MinHeight="380" MinWidth="650">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Hibabejelentések" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <Button Grid.Row="1" Content="Lista frissítése" Command="{Binding LoadReportsCommand}" HorizontalAlignment="Left" Padding="14,7" Margin="0,0,0,14"/>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Reports}" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="55"/>
                <DataGridTextColumn Header="Hiba leírása" Binding="{Binding Description}" Width="*">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="5"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Helyszín" Binding="{Binding Location}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Határidő" Binding="{Binding DueDate, StringFormat='yyyy-MM-dd'}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Érintett eszközök" Binding="{Binding AffectedDeviceCount}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Kategóroia" Binding="{Binding Category}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Állapot" Width="110">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <TextBlock Padding="5"><TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Nyitott"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsClosed}" Value="True"><Setter Property="Text" Value="Lezárva"/></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style></TextBlock>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Művelet" Width="110">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Button Content="Lezárás" Padding="10,5" Margin="3"
                                Command="{Binding DataContext.CloseReportCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding}">
                            <Button.Style><Style TargetType="Button">
                                <Style.Triggers><DataTrigger Binding="{Binding IsClosed}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,14,0,0">
            <TextBlock.Style><Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#344054"/>
                <Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>
